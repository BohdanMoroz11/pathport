{
  "name": "pathport",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @pathport/api --filter @pathport/web dev",
    "dev:web": "pnpm build:packages && pnpm --filter @pathport/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @pathport/api dev",
    "build:packages": "pnpm --filter './packages/**' build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "pnpm --filter @pathport/db db:migrate",
    "db:push": "pnpm --filter @pathport/db db:push",
    "db:seed": "pnpm --filter @pathport/db db:seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "lighthouse": "pnpm build && pnpm db:seed && pnpm lhci",
    "start:stack": "node scripts/start-stack.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "testcontainers": "^12.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7",
    "@types/node": "^22.19.19"
  }
}
