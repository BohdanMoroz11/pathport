{
  "name": "@pathport/ingestion-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pathport/config": "workspace:*",
    "@pathport/contracts": "workspace:*",
    "@pathport/db": "workspace:*",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22.0.0",
    "testcontainers": "^12.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
